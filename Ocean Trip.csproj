<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Ocean_Trip</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <PackageProjectUrl>https://github.com/catrenelle/OceanTrip/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>2024.08.28.23</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="nul" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="UI\Controls\RadioButtonFlat.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="UI\Controls\ToggleButton.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LlamaLibrary" Version="25.1218.1808.49" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="RebornBuddy.ReferenceAssemblies" Version="1.0.902" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- RebornBuddy.ReferenceAssemblies ships a native (non-.NET) Ijwhost.dll inside its managed
       lib/net10.0-windows folder. NuGet exposes every DLL in that folder as a compile-time reference
       candidate, but ResolveAssemblyReferences can't read CLR metadata from a native PE, producing a
       harmless MSB3246 warning every build. Nothing here uses it (it's a C++/CLI interop host,
       unrelated to fishing bot code) — drop it from the reference set before it's resolved. -->
  <Target Name="RemoveIjwhostNativeReference" AfterTargets="ResolveLockFileReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.FileName)' == 'Ijwhost'" />
    </ItemGroup>
  </Target>
</Project>