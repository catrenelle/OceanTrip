<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="28">
			<TextBlock Text="Idle Activities" Style="{DynamicResource HeaderText}" />
			<TextBlock Text="What would you like to do during the downtime between each ocean trip?"
			           Style="{DynamicResource SecondaryText}" Margin="0,0,0,10" />

			<GroupBox Header="Gather Materials" Style="{DynamicResource Card}">
				<WrapPanel x:Name="MaterialsPanel" Orientation="Horizontal" />
			</GroupBox>

			<GroupBox Header="Gather Aethersand" Style="{DynamicResource Card}">
				<WrapPanel x:Name="AethersandsPanel" Orientation="Horizontal" />
			</GroupBox>

			<GroupBox Header="Craft Raid Food" Style="{DynamicResource Card}">
				<WrapPanel x:Name="FoodPanel" Orientation="Horizontal" />
			</GroupBox>

			<GroupBox Header="Craft Raid Potions" Style="{DynamicResource Card}">
				<WrapPanel x:Name="PotionsPanel" Orientation="Horizontal" />
			</GroupBox>

			<GroupBox Header="Restock Crystals" Style="{DynamicResource Card}">
				<WrapPanel Orientation="Horizontal">
					<CheckBox Content="Fire" Margin="0,0,20,6" IsChecked="{Binding firecrystal}" />
					<CheckBox Content="Ice" Margin="0,0,20,6" IsChecked="{Binding icecrystal}" />
					<CheckBox Content="Wind" Margin="0,0,20,6" IsChecked="{Binding windcrystal}" />
					<CheckBox Content="Earth" Margin="0,0,20,6" IsChecked="{Binding earthcrystal}" />
					<CheckBox Content="Lightning" Margin="0,0,20,6" IsChecked="{Binding lightningcrystal}" />
					<CheckBox Content="Water" IsChecked="{Binding watercrystal}" />
				</WrapPanel>
			</GroupBox>

			<GroupBox Header="Purchase Materia" Style="{DynamicResource Card}">
				<StackPanel>
					<ComboBox x:Name="MateriaGradeCombo" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />
					<WrapPanel x:Name="MateriaPanel" Orientation="Horizontal" />
				</StackPanel>
			</GroupBox>

			<GroupBox Header="Crafting &amp; Boat Options" Style="{DynamicResource Card}">
				<WrapPanel Orientation="Horizontal">
					<CheckBox x:Name="UseCraftingFoodCheck" Margin="0,0,32,10" IsChecked="{Binding useCraftingFood}" />
					<CheckBox Content="Refill Crafting Scrips" Margin="0,0,32,10" IsChecked="{Binding refillScrips}" />
					<CheckBox Content="Purchase Hi-Cordials" Margin="0,0,32,10" IsChecked="{Binding purchaseHiCordials}" />
					<CheckBox Content="Use custom &quot;BoatOrder.json&quot; with Lisbeth" Margin="0,0,32,10" IsChecked="{Binding customBoatOrders}" />
					<CheckBox Content="Resume Lisbeth Orders if interrupted" Margin="0,0,32,10" IsChecked="{Binding resumeLisbeth}" />
				</WrapPanel>
			</GroupBox>

		</StackPanel>
	</ScrollViewer>
</UserControl>
